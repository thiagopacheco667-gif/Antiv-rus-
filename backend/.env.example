# Chave da VirusTotal API v3 (https://www.virustotal.com/gui/my-apikey). Nunca a coloque no app.
VT_API_KEY=

# Hash(es) SHA-256 dos tokens do app, separados por vírgula. Gere com: npm run token
AEGIS_CLIENT_TOKEN_HASHES=

# public = API pública (4/min, 500/dia, uso não comercial) | private = conta premium
VT_MODE=public
# VT_RATE_PER_MINUTE=1000
# VT_RATE_PER_DAY=1000000

ALLOW_UPLOADS=true
MAX_UPLOAD_MB=650
CLIENT_RATE_PER_MINUTE=30

# HTTPS: informe certificado e chave, ou TRUST_PROXY_TLS=1 se estiver atrás de um proxy HTTPS.
# TLS_CERT_FILE=/etc/aegis/fullchain.pem
# TLS_KEY_FILE=/etc/aegis/privkey.pem
TRUST_PROXY_TLS=0

HOST=0.0.0.0
PORT=8443
