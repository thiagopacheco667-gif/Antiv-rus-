<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS obrigatório; somente autoridades certificadoras do sistema (CAs instaladas pelo usuário não são aceitas). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
