    <string name="feature_scanner_formats_title">Formatos com inspeção estrutural</string>
    <string name="feature_scanner_format_available">disponível</string>
    <string name="feature_scanner_format_unavailable">indisponível</string>
    <string name="feature_scanner_formats_note">O formato real é identificado pelo conteúdo, não pela extensão. Outros formatos recebem apenas verificações genéricas e resultado inconclusivo.</string>

    <string name="feature_scanner_modes_title">Tipos de análise</string>
    <string name="feature_scanner_local_title">Análise local</string>
    <string name="feature_scanner_local_description">Feita inteiramente no aparelho, sem internet. Os arquivos nunca são executados nem modificados.</string>
    <string name="feature_scanner_online_title">Reputação online (VirusTotal)</string>
    <string name="feature_scanner_online_description">Opcional e oferecida depois da análise local. O hash só é compartilhado com sua confirmação; o envio do arquivo completo exige uma segunda confirmação.</string>

    <string name="feature_scanner_privacy_title">Privacidade por padrão</string>
    <string name="feature_scanner_privacy_body">Nenhum arquivo, hash ou dado sai do aparelho sem a sua confirmação explícita. O histórico guarda apenas metadados.</string>

    <string name="feature_scanner_analyzing_title">Analisando</string>
    <string name="feature_scanner_analyzing_note">A consulta online não faz parte da análise local; ela é oferecida no resultado, com o seu consentimento.</string>
