    <string name="feature_reports_lookup_dialog_title">Compartilhar o hash?</string>
    <string name="feature_reports_lookup_dialog_message">O hash SHA-256 deste arquivo será enviado ao VirusTotal (diretamente ou pelo seu servidor AEGIS). Hashes consultados podem ser registrados pelo serviço e ficar acessíveis a terceiros, como assinantes do VirusTotal. O conteúdo do arquivo não é enviado.</string>
    <string name="feature_reports_lookup_dialog_confirm">Compartilhar hash</string>

    <string name="feature_reports_upload_dialog_title">Enviar o arquivo completo?</string>
    <string name="feature_reports_upload_dialog_message">O arquivo inteiro será enviado ao VirusTotal. Arquivos enviados passam a fazer parte do acervo do serviço e podem ser baixados por terceiros (parceiros e assinantes). Não envie documentos pessoais, arquivos privados ou dados confidenciais.</string>
    <string name="feature_reports_upload_dialog_personal">Atenção: documentos e arquivos compactados frequentemente contêm dados pessoais.</string>
    <string name="feature_reports_upload_dialog_ack">Entendo que o arquivo pode se tornar acessível a terceiros.</string>
    <string name="feature_reports_upload_dialog_confirm">Enviar arquivo</string>

    <string name="feature_reports_reselect_title">Selecione o arquivo novamente</string>
    <string name="feature_reports_reselect_message">Por privacidade, o AEGIS não guarda acesso ao arquivo. Selecione-o de novo; o SHA-256 será conferido antes de qualquer envio.</string>
    <string name="feature_reports_reselect_confirm">Selecionar</string>

